#!/usr/bin/env bash
# Cuts a Herdr worktree for a pull request and sets Claude to work in it.
#
#   herdr-pr-agent "Rebase onto {base}. Fix the conflicts."
#
# fjellydiff fills the {placeholders} in before it runs this, and sets
# FJELLYDIFF_* in the environment. The last line says how it ended, because
# fjellydiff puts that line in its footer.
set -euo pipefail

prompt=${1:?no prompt}
slug=${FJELLYDIFF_SLUG:?no slug}
number=${FJELLYDIFF_NUMBER:?no number}
repo=${FJELLYDIFF_REPO:?no repo}

line=$(herdr-pr-worktree | tail -n1)
pane=${line#*pane=}
pane=${pane%% *}
path=${line#*path=}

# Herdr wants [a-z][a-z0-9_-]{0,31}, unique among the agents that are alive.
name=$(printf 'pr-%s-%s' "${repo##*/}" "$number" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-')
name=${name:0:32}
while herdr agent get "$name" >/dev/null 2>&1; do
  name=${name:0:27}-$((RANDOM % 1000))
done

# A new pane is still running fish's startup, so mise and starship hold the
# foreground and `agent start` rejects the pane with agent_pane_busy. Its
# --timeout waits for the agent after the launch, not for the prompt before it.
deadline=$((SECONDS + 60))
until [[ $(herdr pane process-info --pane "$pane" 2>/dev/null |
  jq -r '.result.process_info | (.foreground_process_group_id == .shell_pid)') == true ]]; do
  ((SECONDS < deadline)) || { echo "pane $pane never reached a shell prompt" >&2; exit 1; }
  sleep 0.5
done

# Claude reads ~/.claude.json when it starts, so trust the worktree before it
# comes up. A worktree is its own Git root, so the source checkout does not
# cover it, and an untrusted one opens on the trust question.
up-claude-trust "$path"

# agent_not_ready means Claude came up at a startup question. The name still
# works, so wait it out rather than throw the worktree away.
if ! start=$(herdr agent start "$name" --kind claude --pane "$pane" 2>&1); then
  [[ $(jq -r '.error.code // ""' <<<"$start" 2>/dev/null) == agent_not_ready ]] ||
    { printf '%s\n' "$start" >&2; exit 1; }
  herdr agent wait "$name" --until idle --until done --timeout 120000 >/dev/null ||
    { echo "$name is stuck at a startup question in $path" >&2; exit 1; }
fi

answer=$(herdr agent prompt "$name" "$prompt" --wait --timeout 900000)
state=$(jq -r '.result.agent.agent_status // "unknown"' <<<"$answer")

herdr notification show "$name is $state on $slug" >/dev/null 2>&1 || true

# `blocked` means it is waiting on a question, which is not the same as done.
echo "$name is $state in $path"
