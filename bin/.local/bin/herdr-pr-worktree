#!/usr/bin/env bash
# Opens a Herdr worktree on the head branch of a pull request.
#
# Reads FJELLYDIFF_REPO, _NUMBER, _BRANCH and _SLUG, which fjellydiff sets for
# every action. Prints `workspace=<id> pane=<id> path=<dir>` on the last line,
# for herdr-pr-agent and for anything else that wants the pane.
set -euo pipefail

repo=${FJELLYDIFF_REPO:?no repo}
number=${FJELLYDIFF_NUMBER:?no number}
branch=${FJELLYDIFF_BRANCH:-pr-$number}
slug=${FJELLYDIFF_SLUG:-$repo#$number}
# Not `[[ ... ]] && focus=...`: under `set -e` a false test would end the script.
focus=--no-focus
if [[ ${1:-} == --focus ]]; then
  focus=--focus
fi

# Repos sit one level under ~/code. The name is not enough on its own: two
# owners can use the same one, so the remote has to agree.
# Bash 3.2 here, so lowercase with tr rather than ${var,,}.
name=${repo##*/}
lower=$(printf '%s' "$repo" | tr '[:upper:]' '[:lower:]')
checkout=""
for candidate in "$HOME"/code/*/"$name"; do
  [[ -d $candidate ]] || continue
  origin=$(git -C "$candidate" remote get-url origin 2>/dev/null) || continue
  origin=$(printf '%s' "$origin" | tr '[:upper:]' '[:lower:]')
  if [[ $origin == *"$lower"* ]]; then
    checkout=$candidate
    break
  fi
done
[[ -n $checkout ]] || { echo "no local checkout for $repo under ~/code" >&2; exit 1; }

# `refs/pull/N/head` reaches a fork too, which `origin/<branch>` does not.
git -C "$checkout" fetch --quiet origin "+refs/pull/$number/head:refs/remotes/origin/pr/$number"

# Already cut and still on disk? Open it rather than fail on the branch name.
json=$(herdr worktree open --cwd "$checkout" --branch "$branch" $focus 2>/dev/null) ||
  json=$(herdr worktree create \
    --cwd "$checkout" \
    --branch "$branch" \
    --base "origin/pr/$number" \
    --label "$slug" \
    $focus)

workspace=$(jq -r '.result.workspace.workspace_id' <<<"$json")
pane=$(jq -r '.result.root_pane.pane_id' <<<"$json")
path=$(jq -r '.result.worktree.path' <<<"$json")
[[ $pane != null ]] || { echo "herdr answered with no pane: $json" >&2; exit 1; }

echo "workspace=$workspace pane=$pane path=$path"
